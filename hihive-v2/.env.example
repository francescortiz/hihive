# ── PostgreSQL local (docker.sh) ─────────────────────────────────
POSTGRES_USER=hihive
POSTGRES_PASSWORD=hihive
POSTGRES_DB=hihive
POSTGRES_PORT=5433
POSTGRES_CONTAINER=hihive-pg

# ── App (build time / server-only) ───────────────────────────────
# Bun carga .env automáticamente en process.env al ejecutar scripts
# y durante `bun --bun vite build`.
DATABASE_URL=postgres://hihive:hihive@localhost:5433/hihive